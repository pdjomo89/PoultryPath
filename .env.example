# Server-side settings live in your Convex deployment, not in a file.
# Set each one with:   npx convex env set NAME "value"
# (use `npx convex env set --prod NAME "value"` for production)

# Password for the /admin inbox (12+ characters). Admin is disabled if unset.
ADMIN_PASSWORD=

# Public URL of the site — used for the "open admin inbox" link in emails
SITE_URL=https://your-site.example

# Where new-submission emails go
NOTIFY_EMAIL=

# SMTP account used to send them. Without SMTP_HOST, submissions are only logged.
# Gmail: smtp.gmail.com, port 587, your address, and an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PoultryPath Website <no-reply@example.com>

# The frontend's VITE_CONVEX_URL is written to .env.local automatically by `npx convex dev`.
