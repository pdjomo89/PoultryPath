{
  "name": "poultrypath",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,convex -c yellow,cyan \"vite\" \"convex dev\"",
    "build": "tsc -b && tsc -p convex --noEmit && vite build",
    "deploy": "convex deploy --cmd \"npm run build\"",
    "import:sqlite": "node scripts/import-sqlite.ts",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "convex": "^1.49.0",
    "lucide-react": "^0.460.0",
    "nodemailer": "^6.9.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "convex-test": "^0.0.38",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
